# ───────────────────────────────────────────────────────────────
# Sophie configuration. The installer copies this to `.env` if needed.
# ───────────────────────────────────────────────────────────────

# Base URL of your local OpenAI-compatible model server.
# Works with Ollama, llama.cpp server, LM Studio, vLLM, etc.
#   Ollama:        http://localhost:11434/v1
#   llama.cpp:     http://localhost:8080/v1
#   LM Studio:     http://localhost:1234/v1
SOPHIE_BASE_URL=http://localhost:11434/v1

# The model name as the server reports it (see `/v1/models`).
# Note: llama.cpp ignores this and serves whatever model is loaded.
SOPHIE_MODEL=qwen3

# API key. Local servers usually ignore this — any non-empty value is fine.
SOPHIE_API_KEY=local

# Sampling. Qwen3 recommends temp ~0.6 for thinking, ~0.7 for normal chat.
SOPHIE_TEMPERATURE=0.6
SOPHIE_TOP_P=0.95
SOPHIE_MAX_TOKENS=8192

# Context budget (tokens) before Sophie trims old turns. Match your server's -c.
SOPHIE_CONTEXT_WINDOW=32768

# Hard ceiling on working-history tokens before compaction fires, independent of
# the context window. A big window (e.g. 200k) does NOT keep a small model
# coherent using all of it, so history is capped here and compacted past it.
SOPHIE_MAX_HISTORY_TOKENS=24000

# Sampler-level tool-call constraint (llama.cpp lazy GBNF grammar): makes
# malformed tool-call JSON impossible. Ignored or auto-disabled on servers
# that don't support it. Set false only if you suspect it's causing trouble.
SOPHIE_TOOL_GRAMMAR=true

# ───────────────────────────────────────────────────────────────
# Serving with llama.cpp (optional, recommended): scripts/serve.sh launches
# llama-server with prompt-cache reuse and — when a draft model is set —
# speculative decoding (typically 1.5–2.5× faster generation, identical
# output). Use a small same-family GGUF as the draft (e.g. Qwen3-0.6B for a
# Qwen3 main model).
# ───────────────────────────────────────────────────────────────
SOPHIE_MODEL_PATH=
SOPHIE_DRAFT_MODEL_PATH=
SOPHIE_SERVER_PORT=8080

# Default mode on launch: "normal" or "plan".
SOPHIE_DEFAULT_MODE=normal

# Request timeout in milliseconds (local models can be slow to first token).
SOPHIE_TIMEOUT_MS=600000

# Voice output. The speak tool works on demand either way. Set this true if you
# want every final Sophie reply spoken aloud. On macOS, voice names come from:
#   say -v '?'
# Sophie only uses female voices; blank or unsupported values fall back to Samantha.
SOPHIE_SPEAK_REPLIES=false
SOPHIE_SPEAK_VOICE=Samantha

# Neural TTS. Sophie starts the local Kokoro sidecar on this URL by default.
# Set SOPHIE_TTS_BACKEND=macos to use macOS `say` instead.
SOPHIE_TTS_BACKEND=sidecar
SOPHIE_TTS_BASE_URL=http://127.0.0.1:8090
SOPHIE_TTS_STREAM_REPLIES=false
SOPHIE_TTS_AUTOSTART=true
# Where your local model files live (used by the TTS sidecar to find the
# Kokoro model/voices below if their paths are left blank).
SOPHIE_MODEL_DIR=
SOPHIE_TTS_MODEL=
SOPHIE_TTS_VOICES=
SOPHIE_TTS_SPEAKER=bf_emma

# ───────────────────────────────────────────────────────────────
# Web search (optional). web_search works keyless via DuckDuckGo.
# Set one or both for higher-quality results (Tavily is preferred).
#   Tavily (free tier): https://app.tavily.com/   -> key starts "tvly-"
#   Brave Search API:   https://api-dashboard.search.brave.com/
# ───────────────────────────────────────────────────────────────
TAVILY_API_KEY=
BRAVE_API_KEY=

# ───────────────────────────────────────────────────────────────
# Telegram — Sophie's link to your phone (optional but recommended).
# Lets her message you, ask questions, and get approval when you're away
# from the terminal, and lets you chat with her remotely. Both values are
# needed for two-way remote contact; without them Sophie still works and
# still pops native desktop notifications.
#
# Setup:
#   1. Message @BotFather in Telegram → /newbot → copy the bot token.
#   2. Send your new bot any message.
#   3. Leave TELEGRAM_CHAT_ID blank, start Sophie: she replies with your
#      chat id. Paste it below and restart.
# ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Minutes of no terminal input AND no conversation before Sophie considers
# herself "away" and starts reaching you remotely instead. Default: 5.
SOPHIE_AWAY_MINUTES=5

# ───────────────────────────────────────────────────────────────
# Calendar sync (optional). Sophie stores calendar events internally first.
# While the TUI is open, she mirrors them to configured external calendars.
# When the TUI is closed, nothing runs; on next launch Sophie reconciles again.
#
# Apple Calendar works only on macOS and uses the local Calendar app.
# Set SOPHIE_APPLE_CALENDAR_SYNC=0 to disable it.
# ───────────────────────────────────────────────────────────────
SOPHIE_APPLE_CALENDAR_SYNC=1
SOPHIE_APPLE_CALENDAR_NAME=Sophie

# Gmail. Required for Sophie's public assistant workflow.
# Sophie uses a Gmail app password over IMAP/SMTP. No browser sign-in flow is
# required.
SOPHIE_EMAIL_ADDRESS=
SOPHIE_EMAIL_APP_PASSWORD=
SOPHIE_EMAIL_IMAP_HOST=imap.gmail.com
SOPHIE_EMAIL_IMAP_PORT=993
SOPHIE_EMAIL_SMTP_HOST=smtp.gmail.com
SOPHIE_EMAIL_SMTP_PORT=465

# ───────────────────────────────────────────────────────────────
# Web app (/webapp) — Sophie's browser chat.
# By default it binds ONLY to this machine (127.0.0.1) and your Tailscale
# interface, so it is reachable from your own devices over your tailnet but
# never from the open LAN. Every API request also requires the per-launch
# access token embedded in the URLs Sophie prints — open those exact links.
# Set a host here only to deliberately bind elsewhere (e.g. 0.0.0.0 for a
# trusted home LAN); the token gate stays on regardless.
# ───────────────────────────────────────────────────────────────
SOPHIE_WEBAPP_HOST=
SOPHIE_WEBAPP_PORT=3737
